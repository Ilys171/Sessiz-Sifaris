---
import { getDictionary } from '../content';
import Icon from './Icon.astro';
import QrPattern from './QrPattern.astro';

const t = getDictionary();
const h = t.hero;
const langs = t.demo.language.options;
---

<section id="top" aria-labelledby="hero-title" class="relative overflow-hidden">
  <div class="container-page grid items-center gap-12 pt-12 pb-20 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:pt-20 lg:pb-28">
    <div class="reveal">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 id="hero-title" class="mt-4">
        <span lang="az" class="block text-[clamp(2.75rem,1.6rem+5vw,5rem)] font-[800] leading-[1.02] tracking-[-0.035em] text-cobalt">
          {t.common.productName}
        </span>
        <span class="mt-3 block text-[clamp(1.75rem,1.3rem+2vw,2.75rem)] leading-[1.12]">{h.headline}</span>
      </h1>
      <p class="mt-3 text-base text-muted">
        <span lang="az">{t.common.productName}</span>: {t.common.productNameMeaning}
      </p>
      <p class="lead mt-6 !text-ink">{h.lead}</p>
      <p class="mt-4 flex items-start gap-2.5 text-muted">
        <Icon name="ear" class="mt-1 shrink-0 text-cobalt" />
        <span>{h.note}</span>
      </p>

      <div class="mt-8">
        <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-2 text-[0.9375rem] font-semibold" aria-label={h.flowLabel}>
          {
            h.flow.map((step, i) => (
              <li class="flex items-center gap-1.5">
                <span class="rounded-full border border-border bg-surface px-3 py-1.5 text-ink shadow-soft">{step}</span>
                {i < h.flow.length - 1 && <Icon name="arrowRight" size={18} class="text-cobalt" />}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="#how-it-works" class="btn btn-primary">
          {t.common.seeHowItWorks}
          <Icon name="arrowDown" size={20} />
        </a>
        <a href="#restaurants" class="btn btn-secondary">{t.common.runPilot}</a>
      </div>
    </div>

    <!-- Visual: phone scanning a QR code on a restaurant wall, built in code. -->
    <figure class="reveal relative mx-auto w-full max-w-[30rem]" role="img" aria-label={h.visualAlt}>
      <div aria-hidden="true" class="relative aspect-[5/6] w-full">
        <!-- wall -->
        <div class="absolute inset-0 rounded-[2rem] bg-cobalt-tint">
          <div class="absolute inset-x-0 bottom-0 h-[22%] rounded-b-[2rem] bg-[#d5dcff]"></div>
          <div class="absolute bottom-[22%] left-[6%] right-[6%] h-2 rounded-full bg-[#c4cdfb]"></div>
        </div>
        <!-- poster -->
        <div class="absolute left-[8%] top-[9%] w-[44%] rotate-[-2deg] rounded-2xl bg-surface p-[4%] shadow-lift">
          <p class="text-center text-[clamp(0.7rem,2.4vw,0.95rem)] font-bold uppercase tracking-wider text-cobalt">{h.visual.poster}</p>
          <QrPattern size="100%" class="mt-2 block" />
          <div class="mt-2 flex justify-center gap-1.5 text-[clamp(0.55rem,1.8vw,0.75rem)] font-semibold text-muted">
            <span>AZ</span><span>·</span><span>RU</span><span>·</span><span>EN</span>
          </div>
        </div>
        <!-- phone -->
        <div class="absolute bottom-[5%] right-[6%] w-[50%] rotate-[3deg] rounded-[2.2rem] bg-ink p-[2.5%] shadow-lift">
          <div class="overflow-hidden rounded-[1.8rem] bg-surface">
            <div class="relative bg-[#1b2148] px-[12%] pt-[14%] pb-[10%]">
              <div class="absolute left-1/2 top-[4%] h-[5%] w-[30%] -translate-x-1/2 rounded-full bg-ink"></div>
              <div class="relative mx-auto w-[78%]">
                <QrPattern size="100%" class="block rounded-sm opacity-95" />
                <div class="absolute -inset-[8%] rounded-lg border-[3px] border-lime"></div>
                <div class="scan-line absolute inset-x-0 top-[4%] h-[3px] rounded-full bg-lime"></div>
              </div>
            </div>
            <div class="space-y-[6%] p-[8%]">
              <p class="text-[clamp(0.6rem,2vw,0.875rem)] font-bold text-ink">{h.visual.screenTitle}</p>
              {
                langs.map((l, i) => (
                  <div
                    lang={l.lang}
                    class:list={[
                      'rounded-lg border px-[8%] py-[5%] text-[clamp(0.55rem,1.9vw,0.8rem)] font-semibold',
                      i === 0 ? 'border-cobalt bg-cobalt text-white' : 'border-border text-ink',
                    ]}
                  >
                    {l.label}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>
