---
import { getDictionary } from '../content';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const t = getDictionary();
const p = t.problem;
---

<section id="problem" aria-labelledby="problem-title" class="section border-t border-border bg-surface">
  <div class="container-page">
    <SectionHeading id="problem-title" eyebrow={p.eyebrow} title={p.title} />

    <ol class="mt-12 grid gap-5 md:grid-cols-3">
      {
        p.cards.map((card, i) => (
          <li class="reveal rounded-[var(--radius-card)] border border-border bg-bg p-7">
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-5 text-2xl">
              <span class="sr-only">{i + 1}. </span>
              {card.title}
            </h3>
            <p class="mt-3 text-muted">{card.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-8 flex flex-col gap-5 rounded-[var(--radius-panel)] bg-cobalt p-7 text-white sm:flex-row sm:items-center sm:p-9 on-cobalt">
      <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-white text-cobalt">
        <Icon name="qr" size={34} />
      </span>
      <p class="text-[clamp(1.25rem,1.1rem+0.7vw,1.625rem)] font-semibold leading-snug">{p.highlight}</p>
    </div>
  </div>
</section>
