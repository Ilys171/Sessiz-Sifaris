---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  class?: string;
}
const { id, eyebrow, title, lead, class: className } = Astro.props;
---

<div class:list={['reveal max-w-3xl', className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="h2 mt-3">{title}</h2>
  {lead && <p class="lead mt-5">{lead}</p>}
  <slot />
</div>
