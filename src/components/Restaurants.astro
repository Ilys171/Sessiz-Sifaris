---
import { getDictionary, format } from '../content';
import { siteConfig } from '../config';
import SectionHeading from './SectionHeading.astro';
import Icon, { type IconName } from './Icon.astro';

const t = getDictionary();
const r = t.restaurants;
const f = r.form;
const icons: IconName[] = ['qr', 'store', 'card'];

const fields = [
  { name: 'name', type: 'text', ...f.fields.name },
  { name: 'restaurant', type: 'text', ...f.fields.restaurant },
  { name: 'city', type: 'text', ...f.fields.city },
  { name: 'email', type: 'email', ...f.fields.email },
] as const;

const formText = {
  required: f.errors.required,
  email: f.errors.email,
  summary: f.errors.summary,
  sending: f.sending,
  submit: f.submit,
  success: f.success,
  failure: format(f.failure, { email: siteConfig.contactEmail }),
  notConnected: format(f.notConnected, { email: siteConfig.contactEmail }),
};
---

<section id="restaurants" aria-labelledby="restaurants-title" class="section border-t border-border bg-surface">
  <div class="container-page grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
    <div>
      <SectionHeading id="restaurants-title" eyebrow={r.eyebrow} title={r.title} lead={r.lead} />

      <div class="reveal mt-10">
        <h3 class="text-2xl">{r.needTitle}</h3>
        <ul class="mt-5 space-y-4">
          {
            r.need.map((n, i) => (
              <li class="flex gap-4">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cobalt-tint text-cobalt">
                  <Icon name={icons[i]} size={24} />
                </span>
                <div>
                  <h4 class="text-lg">{n.title}</h4>
                  <p class="text-muted">{n.text}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <h3 class="mt-10 text-2xl">{r.getTitle}</h3>
        <p class="mt-3 text-muted">{r.get}</p>

        <div class="photo-placeholder mt-8 aspect-[16/9]" role="img" aria-label={r.photoAlt}>
          <span aria-hidden="true">{r.photoPlaceholder}</span>
        </div>
      </div>
    </div>

    <div class="reveal">
      <form
        id="pilot-form"
        class="card p-6 sm:p-9 lg:sticky lg:top-[calc(var(--header-h)+2rem)]"
        aria-labelledby="form-title"
        novalidate
        data-pilot-form
        data-endpoint={siteConfig.formEndpoint}
        data-text={JSON.stringify(formText)}
      >
        <h3 id="form-title" class="text-3xl">{f.title}</h3>
        <p class="mt-2 text-base text-muted">{f.required}</p>

        <div data-form-summary tabindex="-1" class="mt-5 hidden items-start gap-2 rounded-xl border-2 border-error bg-white p-4 font-semibold text-error">
          <Icon name="alert" class="mt-0.5 shrink-0" />
          <span data-form-summary-text></span>
        </div>

        <div class="mt-6 space-y-5">
          {
            fields.map((field) => (
              <div data-field>
                <label for={`f-${field.name}`} class="block font-semibold">
                  {field.label}
                </label>
                <input
                  id={`f-${field.name}`}
                  name={field.name}
                  type={field.type}
                  autocomplete={field.autocomplete}
                  required
                  aria-describedby={`f-${field.name}-error`}
                  class="field mt-2"
                />
                <p id={`f-${field.name}-error`} class="field-error mt-2 hidden items-start gap-2 font-semibold text-error">
                  <Icon name="alert" size={20} class="mt-0.5 shrink-0" />
                  <span data-error-text></span>
                </p>
              </div>
            ))
          }
          <div>
            <label for="f-message" class="block font-semibold">
              {f.fields.message.label}
            </label>
            <p id="f-message-hint" class="text-base text-muted">{f.fields.message.hint}</p>
            <textarea id="f-message" name="message" rows="4" aria-describedby="f-message-hint" class="field mt-2"></textarea>
          </div>
        </div>

        <p class="mt-5 text-base text-muted">
          {f.privacyNote}{' '}
          <a href={siteConfig.privacyPath} class="link">{f.privacyLink}</a>.
        </p>

        <button type="submit" class="btn btn-primary mt-6 w-full sm:w-auto" data-submit>{f.submit}</button>

        <div data-form-status role="status" aria-live="polite" class="mt-5 empty:hidden"></div>
      </form>
    </div>
  </div>
</section>

<style>
  .field {
    display: block;
    width: 100%;
    min-height: 3.25rem;
    border-radius: 0.875rem;
    border: 2px solid var(--border);
    background: var(--surface);
    padding: 0.75rem 1rem;
    font-size: 1.125rem;
    color: var(--ink);
  }
  .field:hover {
    border-color: #b9c3f0;
  }
  .field:focus {
    border-color: var(--cobalt);
  }
  .field[aria-invalid='true'] {
    border-color: var(--error);
  }
</style>

<script>
  import { initPilotForm } from '../scripts/form';
  initPilotForm();
</script>
