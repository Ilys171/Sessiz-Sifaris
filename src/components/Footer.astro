---
import { getDictionary, format } from '../content';
import { siteConfig } from '../config';
import Icon from './Icon.astro';

const t = getDictionary();
const a = t.about;
const year = new Date().getFullYear();
---

<footer id="about" aria-labelledby="about-title" class="border-t border-border bg-bg">
  <div class="container-page grid gap-10 py-16 lg:grid-cols-[1.4fr_1fr_1fr] lg:gap-16">
    <div>
      <h2 id="about-title" class="text-3xl">{a.title}</h2>
      <p class="mt-4 max-w-xl text-lg">
        {a.text}
      </p>
    </div>

    <div>
      <h3 class="text-xl">{a.teamTitle}</h3>
      <p class="photo-placeholder mt-4 !justify-start !text-left">{a.team}</p>
    </div>

    <div>
      <h3 class="text-xl">{a.contact}</h3>
      <ul class="mt-4 space-y-1">
        <li>
          <a href={`mailto:${siteConfig.contactEmail}`} class="link inline-flex min-h-11 items-center gap-2">
            <Icon name="mail" size={20} />
            {siteConfig.contactEmail}
          </a>
        </li>
        <li>
          <a href={siteConfig.privacyPath} class="link inline-flex min-h-11 items-center">{a.privacy}</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border">
    <div class="container-page flex flex-col gap-2 py-6 text-base text-muted sm:flex-row sm:justify-between">
      <p><span lang="az" class="font-semibold text-ink">{t.common.productName}</span></p>
      <p>{format(a.copyright, { year })}</p>
    </div>
  </div>
</footer>
