---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Journey from '../components/Journey.astro';
import Demo from '../components/Demo.astro';
import FirstSeconds from '../components/FirstSeconds.astro';
import LanguageProfile from '../components/LanguageProfile.astro';
import TwoPaths from '../components/TwoPaths.astro';
import Questions from '../components/Questions.astro';
import Completion from '../components/Completion.astro';
import Pilot from '../components/Pilot.astro';
import Restaurants from '../components/Restaurants.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Problem />
    <Journey />
    <Demo />
    <FirstSeconds />
    <LanguageProfile />
    <TwoPaths />
    <Questions />
    <Completion />
    <Pilot />
    <Restaurants />
    <CtaBand />
  </main>
  <Footer />
</Base>
