---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { getDictionary } from '../content';

const t = getDictionary();
const p = t.privacyPage;
---

<Base title={`${p.title} · ${t.common.productName}`}>
  <Header base="/" />
  <main id="main" tabindex="-1" class="section">
    <div class="container-page max-w-3xl">
      <h1 class="h2">{p.title}</h1>
      <p class="lead mt-5 !text-ink">{p.lead}</p>
      <ul class="mt-8 space-y-3">
        {
          p.points.map((pt) => (
            <li class="flex items-start gap-3">
              <Icon name="check" size={22} class="mt-1 shrink-0 text-cobalt" strokeWidth={2.4} />
              <span>{pt}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-10">
        <a href="/" class="btn btn-secondary">{p.back}</a>
      </p>
    </div>
  </main>
  <Footer />
</Base>
